# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Database Configuration
# Use the Session Pooler values from Supabase Connect when direct DB_HOST
# resolves only to IPv6 or port 5432 is blocked by the current network.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DB_HOST=aws-0-[YOUR-REGION].pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.[YOUR-PROJECT-REF]
DB_PASSWORD=your_supabase_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Zoho OAuth Configuration
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback

# Zoho Application URLs
ZOHO_PEOPLE_URL=https://people.zoho.com
ZOHO_CRM_URL=https://crm.zoho.com
ZOHO_DESK_URL=https://desk.zoho.com
ZOHO_BOOKS_URL=https://books.zoho.com

# CORS Configuration
FRONTEND_URL=http://localhost:5173
